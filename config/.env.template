# ============================================================
# AI HR Recruitment Automation — Environment Template
# Copy to .env and fill with REAL values before deployment
# ============================================================

# -----------------------------------------------------------------------------
# GOOGLE WORKSPACE CREDENTIALS (OAuth2)
# Configure in n8n UI: Credentials → Google Drive/Sheets/Gmail OAuth2 API
# Names MUST match workflow references:
#   "Google Drive (AI HR)", "Google Sheets (AI HR)", "Gmail (AI HR)"
# -----------------------------------------------------------------------------
GOOGLE_FORMS_CREDENTIALS=
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_SHEETS_CREDENTIALS=
GMAIL_CREDENTIALS=

# -----------------------------------------------------------------------------
# LLM API CONFIGURATION
# Get from your LLM provider (OpenAI, Anthropic, OpenRouter, local, etc.)
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# N8N CONFIGURATION
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_TIMEZONE=Asia/Jakarta
# Generate: openssl rand -hex 16  (32 chars)
N8N_ENCRYPTION_KEY=

# Basic Auth for n8n UI (recommended for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# HR NOTIFICATION
# Single HR email for High/Medium candidate notifications
# -----------------------------------------------------------------------------
HR_EMAIL=hr@yourcompany.com

# -----------------------------------------------------------------------------
# GOOGLE SHEETS IDs
# Get from spreadsheet URL: https://docs.google.com/spreadsheets/d/{ID}/edit
# -----------------------------------------------------------------------------
SHEET_ID_DATA_KANDIDAT=
SHEET_ID_AUDIT_LOG=

# -----------------------------------------------------------------------------
# BUFFER & FALLBACK
# Local directory for JSON buffer files when Google Sheets write fails
# -----------------------------------------------------------------------------
BUFFER_DIR=/home/n8n/ai-hr-recruitment/buffer

# -----------------------------------------------------------------------------
# AUTO-REPLY CUSTOMIZATION (optional)
# Override default rejection email subject/template if needed
# -----------------------------------------------------------------------------
# EMAIL_SUBJECT_REJECT=Informasi Lamaran - {lowongan}
# EMAIL_TEMPLATE_REJECT_PATH=

# -----------------------------------------------------------------------------
# LOG LEVEL (optional)
# -----------------------------------------------------------------------------
# N8N_LOG_LEVEL=info
# N8N_LOG_OUTPUT=console