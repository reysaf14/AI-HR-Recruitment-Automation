# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Project: AI HR Recruitment Automation
# Copy file ini ke `.env` dan isi nilainya. JANGAN commit .env asli.
# ============================================================

# ------------------------------------------------------------
# Google Services (OAuth2 credentials via n8n credential store)
# Catatan: credentials Google di n8n di-set melalui UI n8n,
# bukan lewat env var ini. Env var ini hanya untuk referensi.
# ------------------------------------------------------------
GOOGLE_FORMS_CREDENTIALS=
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_SHEETS_CREDENTIALS=
GMAIL_CREDENTIALS=

# ------------------------------------------------------------
# Google Sheets IDs (ganti per lowongan)
# ------------------------------------------------------------
# Spreadsheet ID dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit
SHEET_KANDIDAT_ID=
SHEET_KRITERIA_ID=
SHEET_AUDIT_ID=

# Nama tab di spreadsheet
SHEET_KANDIDAT_TAB=Data Kandidat
SHEET_KRITERIA_TAB=Kriteria Lowongan
SHEET_AUDIT_TAB=Audit Log

# ------------------------------------------------------------
# LLM API
# ------------------------------------------------------------
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# ------------------------------------------------------------
# n8n Configuration
# ------------------------------------------------------------
N8N_PORT=5678
N8N_WEBHOOK_URL=
N8N_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------
# HR Notification
# ------------------------------------------------------------
HR_EMAIL=

# ------------------------------------------------------------
# Buffer & Fallback (jika Google Sheets gagal)
# ------------------------------------------------------------
BUFFER_DIR=./buffer

# ------------------------------------------------------------
# Konfigurasi Skoring (default, bisa di-override per lowongan
# di Sheet "Kriteria Lowongan")
# ------------------------------------------------------------
SCORE_AMBANG_HIGH=80
SCORE_AMBANG_LOW=40

# ------------------------------------------------------------
# Konfigurasi Retry & Timeout (detik)
# ------------------------------------------------------------
RETRY_MAX=3
TIMEOUT_DOWNLOAD_CV=30
TIMEOUT_PARSE_CV=60
TIMEOUT_LLM=120
TIMEOUT_SHEETS=30
TIMEOUT_EMAIL=30

# ------------------------------------------------------------
# Auto-Reply
# ------------------------------------------------------------
AUTO_REPLY_DELAY_DAYS=3
EMAIL_SUBJECT_REJECT="Informasi Lamaran - {lowongan}"